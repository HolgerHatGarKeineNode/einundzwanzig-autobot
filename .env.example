# Autobot — Secrets (NIP-46-Login via Amber o. a. Bunker)
# `npm run setup` kopiert diese Datei nach .env — .env ist gitignored, NIE committen.
# Alles NICHT-Geheime (Ziel-URL, Relays, Blossom, FLUX2-Pfad) steht in autobot.config.json.

# Vollständige bunker://…-URL aus deiner Signer-App (Amber: Einstellungen → neuer
# Bunker-Login; enthält pubkey, relays und secret). Danach: npm run gen:inject
NOSTR_BUNKER_URL=

# Persistenter Client-Key (64 Zeichen hex). `npm run setup` erzeugt ihn automatisch.
# Derselbe Key über alle Sessions ⇒ der Signer fragt nur beim ALLERERSTEN Connect.
NOSTR_CLIENT_SK=
