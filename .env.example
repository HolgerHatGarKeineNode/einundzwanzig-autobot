# Autobot — NIP-46 (Amber Bunker) Login für media.einundzwanzig.space
# Kopiere diese Datei zu .env und trage die NEU erzeugte Bunker-URL ein.
# .env ist gitignored und wird NIE committet.

# Vollständige bunker://… URL aus Amber (enthält pubkey, relays und secret)
NOSTR_BUNKER_URL=

# Ziel-Site
TARGET_BASE_URL=https://media.einundzwanzig.space

# Optional: Playwright headless (true) oder sichtbar (false) beim Entwickeln
HEADLESS=false
